# Copy to .env in the consuming application's working directory (or point
# LOCALOPS_ENV_FILE at it) and call client.LoadEnvFile("") before
# client.Init(client.ConfigFromEnv()). Real environment variables always
# take precedence over this file.

# "staging" enables the real client (together with LOCALOPS_URL below).
# Any other value (including leaving this unset) keeps LocalOps a no-op -
# safe default for production.
PROFILE=staging

# Alternative to PROFILE=staging: force-enable without adopting a PROFILE
# concept. LOCALOPS_URL is still required either way.
# LOCALOPS_ENABLED=true

# Base URL of the LocalOps server. Mini-PC-local by default; reachable
# from elsewhere over Tailscale if ever needed.
LOCALOPS_URL=http://localhost:7717

# Label attached to every task/watcher this process reports.
LOCALOPS_SERVER=wvs-server
