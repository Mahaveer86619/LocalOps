# LocalOps server configuration. Copy to .env next to the binary (or set
# LOCALOPS_ENV_FILE), or export these directly in the systemd unit.

# Port the REST API listens on.
LOCALOPS_PORT=7717

# SQLite database file.
LOCALOPS_DB_PATH=/opt/localops/localops.db

# Slack incoming webhook URL. Leave unset to disable alerting entirely
# (watcher/stuck-task events are still recorded, just not sent to Slack).
LOCALOPS_SLACK_WEBHOOK_URL=

# Slack app-level token (xapp-...), Basic Information > App-Level Tokens,
# connections:write scope. Enables Socket Mode: LocalOps opens an outbound
# WebSocket to Slack, so slash commands (/health, /status, /tasks, /task,
# /watchers, /watcher, /notify) arrive with no public HTTP endpoint needed
# at all. This is the recommended path if Socket Mode is enabled on your
# Slack app (Settings > Socket Mode) - leave unset to disable it.
LOCALOPS_SLACK_APP_TOKEN=

# Slack app Signing Secret (Basic Information page) - only needed for the
# alternative HTTP path (POST /slack/commands) if Socket Mode is OFF and
# you're using a Request URL + public tunnel (e.g. Tailscale Funnel)
# instead. Leave unset to reject all such requests; outbound alerting and
# Socket Mode above are unaffected either way.
LOCALOPS_SLACK_SIGNING_SECRET=

# Consecutive failed check-ins before a watcher's first "down" alert.
LOCALOPS_WATCHER_FAIL_THRESHOLD=2

# Multiplier applied to a task's expected_heartbeat_s before it's
# considered stuck.
LOCALOPS_STUCK_MULTIPLIER=3

# How often (seconds) the stuck-task sweep and schedule runner tick.
LOCALOPS_SWEEP_INTERVAL_S=30
